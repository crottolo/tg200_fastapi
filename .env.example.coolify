# ==============================================================================
# COOLIFY ENVIRONMENT VARIABLES
# ==============================================================================
# Queste variabili devono essere configurate nell'UI di Coolify
# Coolify le rileva automaticamente dal docker-compose.yml
#
# IMPORTANTE: Non committare valori reali! Usa questo file come riferimento.
# ==============================================================================

# ------------------------------------------------------------------------------
# VARIABILI OBBLIGATORIE (⚠️ DA CONFIGURARE IN COOLIFY)
# ------------------------------------------------------------------------------
# Coolify richiederà queste variabili (marcate con :? nel compose file)

# TG200 Gateway Connection
TG200_HOST=37.117.57.200        # IP o hostname del TG200
TG200_USERNAME=apiuser           # Username AMI
TG200_PASSWORD=apipass           # Password AMI

# API Security
API_BEARER_TOKEN=CHANGE-ME-TO-SECURE-TOKEN  # ⚠️ IMPORTANTE: Usa un token sicuro!

# Webhook Destination
WEBHOOK_URL=https://your-webhook-endpoint.com/webhook  # URL dove inviare gli eventi


# ------------------------------------------------------------------------------
# VARIABILI OPZIONALI (✅ Default già configurati nel compose file)
# ------------------------------------------------------------------------------
# Puoi sovrascriverle nell'UI di Coolify se necessario

# TG200_PORT=5038                    # Porta AMI (default: 5038)
# TG200_DEFAULT_SPAN=2               # Span GSM di default (2 o 3)

# WEBHOOK_ENABLED=true               # Abilita/disabilita webhook (default: true)
# WEBHOOK_TIMEOUT=5.0                # Timeout webhook in secondi (default: 5.0)
# WEBHOOK_RETRY=0                    # Numero di retry (0-3, default: 0)
# WEBHOOK_SEND_ALL_EVENTS=true      # Invia tutti eventi AMI (default: true)
# WEBHOOK_SEND_KEEPALIVE=false      # Invia Ping/Pong ogni 25s (default: false, consigliato)


# ==============================================================================
# COME USARE IN COOLIFY
# ==============================================================================
#
# 1. Crea Resource "Docker Compose" in Coolify
# 2. Vai alla tab "Environment Variables"
# 3. Coolify mostra automaticamente tutte le variabili ${} dal docker-compose.yml
# 4. Imposta le variabili OBBLIGATORIE (quelle sopra con ⚠️)
# 5. (Opzionale) Modifica i default se necessario
# 6. Deploy!
#
# ==============================================================================
